---
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";
---

<BaseLayout title="页面不存在" description="这个地址下没有内容。">
  <div class="flex flex-col items-start gap-4 py-10">
    <p class="text-sm font-medium tracking-wide text-accent">404</p>
    <h1 class="text-2xl font-semibold tracking-tight">这个地址下没有内容</h1>
    <p class="max-w-md text-sm leading-relaxed text-muted">
      链接可能写错了，或者那篇文章已经被删掉。
    </p>
    <div class="mt-2 flex flex-wrap gap-2">
      <a
        href={withBase("/")}
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-3.5 py-2 text-sm text-white transition-opacity hover:opacity-90"
      >
        <Icon name="arrow" size={15} class="rotate-180" />
        回到首页
      </a>
      <a
        href={withBase("posts/")}
        class="inline-flex items-center gap-2 rounded-lg border border-line px-3.5 py-2 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
      >
        浏览文章
      </a>
    </div>
  </div>
</BaseLayout>
