---
import Icon from "../components/Icon.astro";
import PostList from "../components/PostList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { HOME_LIMITS, POSTS_PER_PAGE, SITE, SOCIAL } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts, getSortedProjects, pickFeaturedProjects } from "../utils/content";
import { withBase } from "../utils/url";

const posts = await getPublishedPosts();
const projects = await getSortedProjects();
const featured = pickFeaturedProjects(projects, HOME_LIMITS.featuredProjects);
const recent = posts.slice(0, HOME_LIMITS.recentPosts);
---

<BaseLayout>
  <section class="mb-16">
    <h1 class="text-2xl font-semibold tracking-tight sm:text-[1.75rem]">{SITE.title}</h1>
    <p class="mt-3 max-w-2xl text-[0.95rem] leading-relaxed text-muted">
      {SITE.longDescription}
    </p>
    <div class="mt-5 flex items-center gap-1">
      {
        SOCIAL.map((item) => (
          <a
            href={item.icon === "rss" ? withBase(item.href) : item.href}
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-muted transition-colors hover:bg-accent-soft hover:text-accent"
            title={item.label}
            aria-label={item.label}
            rel="noopener noreferrer"
          >
            <Icon name={item.icon} />
          </a>
        ))
      }
    </div>
  </section>

  <section class="mb-16">
    <SectionHeading title="项目" description="正在做和做过的东西。" moreHref="projects/" />
    {
      featured.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <p class="rounded-xl border border-dashed border-line px-5 py-12 text-center text-sm text-muted">
          还没有项目，在 src/content/projects/ 下新建一个 Markdown 文件即可。
        </p>
      )
    }
  </section>

  <section>
    <SectionHeading
      title="最近写的"
      moreHref="posts/"
      moreLabel={posts.length > HOME_LIMITS.recentPosts ? `全部 ${posts.length} 篇` : "全部文章"}
    />
    <PostList posts={recent} emptyText="还没有文章，在 src/content/posts/ 下新建一个 Markdown 文件即可。" />
  </section>
</BaseLayout>
