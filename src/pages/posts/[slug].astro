---
import { render } from "astro:content";
import Icon from "../../components/Icon.astro";
import TOC from "../../components/TOC.astro";
import { SITE } from "../../config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Post } from "../../utils/content";
import { formatDate, formatDateISO, getPublishedPosts, readingMinutes } from "../../utils/content";
import { withBase } from "../../utils/url";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // 列表按时间倒序，所以 index-1 是更新的，index+1 是更旧的
      newer: posts[index - 1] as Post | undefined,
      older: posts[index + 1] as Post | undefined,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  index
>
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-14">
    <div class="min-w-0">
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-muted">
          <a
            href={withBase(`categories/${encodeURIComponent(post.data.category)}/`)}
            class="rounded-md bg-accent-soft px-2 py-0.5 text-accent transition-opacity hover:opacity-80"
          >
            {post.data.category}
          </a>
          <time datetime={formatDateISO(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
          <span class="inline-flex items-center gap-1">
            <Icon name="clock" size={13} />
            约 {minutes} 分钟
          </span>
        </div>

        <h1
          class="mt-4 text-2xl font-semibold leading-snug tracking-tight sm:text-[1.7rem]"
          data-pagefind-meta="title"
        >
          {post.data.title}
        </h1>

        <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{post.data.description}</p>

        {
          post.data.updatedDate && (
            <p class="mt-2 text-xs text-muted">
              修订于 {formatDate(post.data.updatedDate)}
            </p>
          )
        }
      </header>

      <article class="prose">
        <Content />
      </article>

      {
        post.data.tags.length > 0 && (
          <div class="mt-12 flex flex-wrap items-center gap-2">
            <Icon name="tag" size={15} class="text-muted" />
            {post.data.tags.map((tag) => (
              <a
                href={withBase(`tags/${encodeURIComponent(tag)}/`)}
                class="rounded-md border border-line px-2.5 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }

      {
        (newer || older) && (
          <nav class="mt-14 grid gap-3 border-t border-line pt-8 sm:grid-cols-2" aria-label="相邻文章">
            {newer ? (
              <a
                href={withBase(`posts/${newer.id}/`)}
                class="group flex flex-col gap-1 rounded-xl border border-line px-4 py-3 transition-colors hover:border-accent/50"
              >
                <span class="text-xs text-muted">较新一篇</span>
                <span class="text-sm font-medium leading-snug transition-colors group-hover:text-accent">
                  {newer.data.title}
                </span>
              </a>
            ) : (
              <span class="hidden sm:block" />
            )}
            {older && (
              <a
                href={withBase(`posts/${older.id}/`)}
                class="group flex flex-col gap-1 rounded-xl border border-line px-4 py-3 transition-colors hover:border-accent/50 sm:text-right"
              >
                <span class="text-xs text-muted">较旧一篇</span>
                <span class="text-sm font-medium leading-snug transition-colors group-hover:text-accent">
                  {older.data.title}
                </span>
              </a>
            )}
          </nav>
        )
      }
    </div>

    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <TOC headings={headings} />
      </div>
    </aside>
  </div>
</BaseLayout>
