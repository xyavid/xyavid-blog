---
import Pagination from "../../../components/Pagination.astro";
import PostList from "../../../components/PostList.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import { POSTS_PER_PAGE } from "../../../config";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedPosts, type Post } from "../../../utils/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));

  // 第一页由 src/pages/posts/index.astro 负责，这里生成第 2 页到最后一页
  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, i) => {
    const currentPage = i + 2;
    const start = (currentPage - 1) * POSTS_PER_PAGE;
    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice(start, start + POSTS_PER_PAGE) as Post[],
        currentPage,
        lastPage,
      },
    };
  });
}

const { posts, currentPage, lastPage } = Astro.props;
---

<BaseLayout
  title={`文章 · 第 ${currentPage} 页`}
  description={`文章列表第 ${currentPage} 页，共 ${lastPage} 页。`}
>
  <SectionHeading title="文章" description={`第 ${currentPage} 页，共 ${lastPage} 页。`} />
  <PostList posts={posts} />
  <Pagination currentPage={currentPage} lastPage={lastPage} basePath="posts" />
</BaseLayout>
