---
import { render } from "astro:content";
import Icon from "../../components/Icon.astro";
import { PROJECT_STATUS } from "../../config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatYearMonth, getSortedProjects } from "../../utils/content";
import { withBase } from "../../utils/url";

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const status = PROJECT_STATUS[project.data.status as keyof typeof PROJECT_STATUS];
const period = project.data.endDate
  ? `${formatYearMonth(project.data.startDate)} – ${formatYearMonth(project.data.endDate)}`
  : `${formatYearMonth(project.data.startDate)} 至今`;

const statusClass = {
  active: "bg-accent-soft text-accent",
  done: "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
  muted: "bg-line/60 text-muted",
}[status.tone] as string;
---

<BaseLayout
  title={project.data.name}
  description={project.data.description}
  type="article"
  index
>
  <div class="mx-auto max-w-3xl">
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-3 text-xs text-muted">
        <span class={`rounded-md px-2 py-0.5 ${statusClass}`}>{status.label}</span>
        <span>{period}</span>
      </div>
      <h1 class="mt-4 text-2xl font-semibold tracking-tight sm:text-[1.7rem]" data-pagefind-meta="title">
        {project.data.name}
      </h1>
      <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{project.data.tagline}</p>

      {
        project.data.stack.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {project.data.stack.map((tech) => (
              <span class="rounded-md border border-line px-2 py-0.5 text-xs text-muted">{tech}</span>
            ))}
          </div>
        )
      }

      {
        (project.data.links.repo || project.data.links.demo) && (
          <div class="mt-6 flex flex-wrap gap-2">
            {project.data.links.repo && (
              <a
                href={project.data.links.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg bg-accent px-3.5 py-2 text-sm text-white transition-opacity hover:opacity-90"
              >
                <Icon name="github" size={16} />
                源码仓库
              </a>
            )}
            {project.data.links.demo && (
              <a
                href={project.data.links.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg border border-line px-3.5 py-2 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
              >
                <Icon name="external" size={16} />
                在线预览
              </a>
            )}
          </div>
        )
      }
    </header>

    <article class="prose">
      <Content />
    </article>

    <div class="mt-14 border-t border-line pt-8">
      <a
        href={withBase("projects/")}
        class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent"
      >
        <Icon name="arrow" size={15} class="rotate-180" />
        返回全部项目
      </a>
    </div>
  </div>
</BaseLayout>
