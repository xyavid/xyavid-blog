---
import SectionHeading from "../../components/SectionHeading.astro";
import { CATEGORIES } from "../../config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { countByCategory, getPublishedPosts } from "../../utils/content";
import { withBase } from "../../utils/url";

const posts = await getPublishedPosts();
// 只列出确实有文章的分类：空分类不生成页面，列出来会变成死链
const categories = countByCategory(posts, CATEGORIES).filter((item) => item.count > 0);
---

<BaseLayout title="分类" description="按主题浏览文章。">
  <SectionHeading title="分类" description="分类是固定的几个，每篇文章归属其中一个。" />
  {
    categories.length === 0 ? (
      <p class="rounded-xl border border-dashed border-line px-5 py-12 text-center text-sm text-muted">
        还没有任何分类下的文章。
      </p>
    ) : (
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map(({ category, count }) => (
          <a
            href={withBase(`categories/${encodeURIComponent(category)}/`)}
            class="group flex items-center justify-between rounded-xl border border-line px-4 py-3.5 transition-colors hover:border-accent/50"
          >
            <span class="text-sm font-medium transition-colors group-hover:text-accent">{category}</span>
            <span class="text-xs text-muted">{count} 篇</span>
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
