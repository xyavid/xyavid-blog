---
import { SITE, SOCIAL } from "../config";
import { withBase } from "../utils/url";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line" data-pagefind-ignore>
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-5 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-muted">
      © {year} {SITE.author}
    </p>
    <div class="flex items-center gap-1">
      {
        SOCIAL.map((item) => (
          <a
            href={item.icon === "rss" ? withBase(item.href) : item.href}
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-muted transition-colors hover:bg-accent-soft hover:text-accent"
            title={item.label}
            aria-label={item.label}
            rel="noopener noreferrer"
          >
            <Icon name={item.icon} />
          </a>
        ))
      }
    </div>
  </div>
</footer>
