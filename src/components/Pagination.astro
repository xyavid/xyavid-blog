---
import { withBase } from "../utils/url";

interface Props {
  currentPage: number;
  lastPage: number;
  /** 分页基础路径，不含 base，如 "posts" */
  basePath: string;
}

const { currentPage, lastPage, basePath } = Astro.props;

/** 第一页是 /posts/，第二页起是 /posts/page/2/ */
function pageHref(page: number): string {
  return page === 1 ? withBase(`${basePath}/`) : withBase(`${basePath}/page/${page}/`);
}

const prevHref = currentPage > 1 ? pageHref(currentPage - 1) : undefined;
const nextHref = currentPage < lastPage ? pageHref(currentPage + 1) : undefined;

// 页码窗口：当前页前后各一页，首尾各留一页，中间折叠成省略号
const pages: (number | "gap")[] = [];
for (let page = 1; page <= lastPage; page += 1) {
  const nearCurrent = Math.abs(page - currentPage) <= 1;
  const nearEdge = page === 1 || page === lastPage;
  if (nearCurrent || nearEdge) pages.push(page);
  else if (pages[pages.length - 1] !== "gap") pages.push("gap");
}
---

{
  lastPage > 1 && (
    <nav class="mt-12 flex items-center justify-between gap-3" aria-label="分页导航">
      {
        prevHref ? (
          <a
            href={prevHref}
            class="inline-flex items-center rounded-lg border border-line px-3.5 py-2 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
          >
            上一页
          </a>
        ) : (
          <span class="inline-flex items-center rounded-lg border border-line px-3.5 py-2 text-sm text-line">上一页</span>
        )
      }

      <div class="hidden items-center gap-1 sm:flex">
        {pages.map((page) =>
          page === "gap" ? (
            <span class="px-1.5 text-sm text-muted">…</span>
          ) : (
            <a
              href={pageHref(page)}
              aria-current={page === currentPage ? "page" : undefined}
              class:list={[
                "inline-flex h-9 min-w-9 items-center justify-center rounded-lg px-2 text-sm transition-colors",
                page === currentPage
                  ? "bg-accent-soft font-medium text-accent"
                  : "text-muted hover:text-ink",
              ]}
            >
              {page}
            </a>
          )
        )}
      </div>

      <span class="text-sm text-muted sm:hidden">第 {currentPage} / {lastPage} 页</span>

      {
        nextHref ? (
          <a
            href={nextHref}
            class="inline-flex items-center rounded-lg border border-line px-3.5 py-2 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
          >
            下一页
          </a>
        ) : (
          <span class="inline-flex items-center rounded-lg border border-line px-3.5 py-2 text-sm text-line">下一页</span>
        )
      }
    </nav>
  )
}
