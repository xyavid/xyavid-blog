---
import Icon from "./Icon.astro";
import { withBase } from "../utils/url";

interface Props {
  title: string;
  description?: string;
  /** 右侧「查看全部」链接，不传则不显示 */
  moreHref?: string;
  moreLabel?: string;
  count?: number;
}

const { title, description, moreHref, moreLabel = "查看全部", count } = Astro.props;
---

<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h2 class="flex items-baseline gap-2 text-lg font-semibold tracking-tight">
      {title}
      {count !== undefined && count > 0 && (
        <span class="text-sm font-normal text-muted">{count}</span>
      )}
    </h2>
    {description && <p class="mt-1 text-sm text-muted">{description}</p>}
  </div>
  {
    moreHref && (
      <a
        href={withBase(moreHref)}
        class="group inline-flex items-center gap-1 text-sm text-muted transition-colors hover:text-accent"
      >
        {moreLabel}
        <Icon name="arrow" size={15} class="transition-transform group-hover:translate-x-0.5" />
      </a>
    )
  }
</div>
