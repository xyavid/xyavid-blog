---
import PostCard from "./PostCard.astro";
import type { Post } from "../utils/content";

interface Props {
  posts: Post[];
  hideCategory?: boolean;
  emptyText?: string;
}

const { posts, hideCategory = false, emptyText = "还没有文章。" } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="rounded-xl border border-dashed border-line px-5 py-12 text-center text-sm text-muted">
      {emptyText}
    </p>
  ) : (
    <div class="flex flex-col divide-y divide-line">
      {posts.map((post) => (
        <div class="py-1">
          <PostCard post={post} hideCategory={hideCategory} />
        </div>
      ))}
    </div>
  )
}
